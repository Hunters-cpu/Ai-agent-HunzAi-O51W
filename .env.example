# ============================================
# BOT SETTINGS
# ============================================
MAX_BOTS_PER_USER=20
SESSION_DIR=./sessions
LOG_LEVEL=info
POLL_INTERVAL=10000

# Auto-cleanup bot yang timeout (ms) — default 15 menit
BOT_TIMEOUT_MS=900000
